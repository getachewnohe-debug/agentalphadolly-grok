# Example environment variables for the X mention-reply bot

# Twitter API credentials (do NOT commit real secrets)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_USER_ID=

# LLM configuration
LLM_PROVIDER=openai    # or 'grok' if you have a Grok API
LLM_API_KEY=

# Bot behavior
BOT_REPLY_PREFIX=[AgentAlphaDolly]
POLL_INTERVAL_SECONDS=30

# Optional: limit replies per poll
MAX_REPLIES_PER_CYCLE=5
