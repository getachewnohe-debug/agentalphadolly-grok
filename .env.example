# xAI Grok API Key (get from https://console.x.ai)
XAI_API_KEY=

# GitHub Personal Access Token or GitHub App installation token
# Scopes needed: repo, issues, pull_requests
GITHUB_TOKEN=

# Default repository the agent operates on
GITHUB_OWNER=getachewnohe-debug
GITHUB_REPO=Agent-alpha-dolly

# Optional: model override (default: grok-3 or grok-4 depending on availability)
XAI_MODEL=grok-3
